# =============================================================================
# Computational-Immuno-oncology — .gitignore
# =============================================================================
# This repo holds TEACHING MATERIAL: documents, scripts, notebooks, small
# example data. It must NOT hold analysis outputs, sequencing data, or secrets.
#
# Rule of thumb: if it can be regenerated by running a script, it does not
# belong in git.  Students keep run outputs under $HOME, never in this repo.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Secrets & credentials  (see skill: github-safe-push)
# -----------------------------------------------------------------------------
*api*key*
*apikey*
*secret*
*credential*
*password*
*passwd*
*token*
*.env
*.env.*
.env.local
.env.*.local
*.local
*.local.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.crt
*.cer
*.der
*.csr
*.p8
*.ppk
*.local.jsonc
*.local.json
*.local.yaml
*.local.yml
*.local.toml
config.local.*
settings.local.*
# allow committed templates
!*.example
!*.template
!*.dist
!*.sample

# -----------------------------------------------------------------------------
# 2. Sequencing data — never in git (huge + often controlled-access)
# -----------------------------------------------------------------------------
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.sra
*.fast5
*.pod5
*.bam
*.bai
*.cram
*.crai
*.sam
*.sai
*.bed.gz
*.bed.gz.tbi
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.g.vcf
*.g.vcf.idx
*.bcf
*.gvcf
*.idat
*.cel
# small teaching fixtures may be force-added with: git add -f <path>
!WES/ref/*.bed
!WES/ref/*.fa
!WES/ref/*.fasta

# -----------------------------------------------------------------------------
# 3. Pipeline run outputs
# -----------------------------------------------------------------------------
wes_run_cluster_*/
wes_run_*/
run_*/
*.clean.fq.gz
*.clean.fastq.gz
*.flagstat.txt
*.markdup.bam
*.markdup.bam.bai
*_sorted.bam
*_sorted.bam.bai
*_markdup_metrics.txt
*.recal_data.table
*.recal
*.tranches
*.plots.R
*.avinput
*_multianno.txt
*.hg38_multianno.txt
*.cnn
*.cnr
*.cns
*.call.cns
*.seg
*.targetcoverage.cnn
*.antitargetcoverage.cnn
*.reference.cnn
*scatter*.png
*diagram*.pdf
*.fastp.html
*.fastp.json
*.multiqc.html
*.multiqc_data/
*.vcf.stats
f1r2.tar.gz
orientation_model.tar.gz
tmb.txt
coverage_summary.txt

# -----------------------------------------------------------------------------
# 4. Logs & job scheduler output
# -----------------------------------------------------------------------------
*.log
logs/
log/
slurm-*.out
slurm-*.err
*.out
*.err
core.*

# -----------------------------------------------------------------------------
# 5. Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
build/
dist/
develop-eggs/
downloads/
wheels/
pip-wheel-metadata/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
Rplots.pdf
.Rhistory
.RData
.Rproj.user/

# -----------------------------------------------------------------------------
# 6. Editors & OS
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-*
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# 7. Temp & backups
# -----------------------------------------------------------------------------
tmp/
temp/
.cache/
*.tmp
*.bak
*.backup
*.bkp
*.old
*.orig
*~